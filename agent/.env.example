# Caminho do binário já compilado do ticketlens (Go), raiz do repo:
#   cd .. && go build -o ticketlens .
MCP_SERVER_BINARY=../ticketlens

# LLM usado pelo agente (create_react_agent). Troque o provider em
# investigate.py se preferir OpenAI/outro em vez de Anthropic.
ANTHROPIC_API_KEY=

# Repassadas pro processo do MCP server (mesmas do README raiz) — o
# agente propaga todo o os.environ pro subprocesso, então setar aqui já
# basta.
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
GITHUB_TOKEN=
LOGS_PROVIDER=datadog
DD_API_KEY=
DD_APP_KEY=
# ou, se LOGS_PROVIDER=elasticsearch:
# ELASTICSEARCH_URL=
# ELASTICSEARCH_API_KEY=
