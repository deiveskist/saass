# This is an example of your .env file format. Copy to .env:
#   cp .env.example .env
# Note: must be .env, not .env.local (dotenv.config() só lê .env aqui).

# Postgres local via docker-compose (../docker-compose.yml):
#   docker compose -f ../docker-compose.yml up -d
POSTGRES_URL=postgresql://postgres:postgres@localhost:54322/ticketlens_web

# Chaves de teste do Stripe funcionam pra rodar localmente (auth/dashboard/
# investigate não chamam o Stripe); só o checkout em /pricing precisa de
# chaves reais.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
BASE_URL=http://localhost:3000
AUTH_SECRET=dev-local-secret-troque-em-producao

# Supportability MCP backend — suba com ../scripts/dev-local.sh (mock
# server + servidor Go, sem nenhuma credencial real do Zendesk/GitHub/Datadog)
MCP_HTTP_URL=http://localhost:8080
INTERNAL_API_KEY=dev-local-key